# ==============================================================================
# AAN / RYOKO TRAVEL PLATFORM — SERVER-SIDE ENVIRONMENT CONFIGURATION
# ==============================================================================
# 
# SECURITY ARCHITECTURE & STRICT GUIDELINES:
# - NEVER prefix these variables with VITE_.
# - These credentials are read STRICTLY server-side by the Vite dev proxy middleware
#   (server/vitePluginPlacesProxy.ts) and serverless backend API handlers (api/).
# - Secrets are NEVER bundled into client JavaScript, emitted to the browser,
#   or stored in localStorage/sessionStorage.
# - DO NOT commit real keys to Git. Copy this file to '.env.local':
#     copy .env.example .env.local
#
# ------------------------------------------------------------------------------
# 1. PLACES & ATTRACTIONS PROVIDERS
# ------------------------------------------------------------------------------
# OpenTripMap API Key for live attraction discovery
# Register at: https://opentripmap.io/
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here

# Google Places API (New) Key (Server-Side Proxy: /api/places)
# Register at: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 2. ROUTES & TRAVEL TIMES PROVIDER
# ------------------------------------------------------------------------------
# Google Routes / Directions API Key (Server-Side Proxy: /api/routes)
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here

# ------------------------------------------------------------------------------
# 3. WEATHER PROVIDER
# ------------------------------------------------------------------------------
# OpenWeatherMap API Key (Server-Side Proxy: /api/weather)
# Register at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ------------------------------------------------------------------------------
# 4. FLIGHTS PROVIDER
# ------------------------------------------------------------------------------
# Amadeus Travel API Credentials (Server-Side Proxy: /api/flights)
# Register at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# ------------------------------------------------------------------------------
# 5. HOTELS & ACCOMMODATION PROVIDER
# ------------------------------------------------------------------------------
# Hotel Partner API Key (Server-Side Proxy: /api/hotels)
HOTEL_PROVIDER_API_KEY=your_hotel_provider_api_key_here
